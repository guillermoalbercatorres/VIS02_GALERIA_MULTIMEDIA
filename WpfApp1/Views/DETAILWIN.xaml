<Window x:Class="WpfApp1.DETAILWIN"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NaviVision - Visor de archivo"
        Height="720"
        Width="1080"
        MinHeight="500"
        MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/ImageStyles.xaml" />
                <ResourceDictionary Source="../Resources/MediaStyles.xaml" />
                <ResourceDictionary Source="../Resources/TextStyles.xaml" />
                <ResourceDictionary Source="../Resources/MarkdownStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Estilo local del visor: más redondeado y sombreado que los botones de navegación. -->
            <Style TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.18" />
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Abrir externamente"
                            Margin="0,0,10,0"
                            Click="BtnAbrirExterno_Click" />
                    <Button Content="✖ Cerrar visor"
                            IsCancel="True"
                            Click="Button_Cerrar_Click" />
                </StackPanel>
                <TextBlock x:Name="txtNombreArchivo"
                           Text="Visor multimedia"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Border x:Name="panelImagen"
                    Style="{StaticResource ImagePreviewContainerStyle}"
                    Visibility="Collapsed">
                <Grid Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Image x:Name="Imagen"
                           Grid.Row="0"
                           Style="{StaticResource ImagePreviewStyle}"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Image.RenderTransform>
                    </Image>
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,0">
                        <Button Content="− Zoom"
                                Style="{StaticResource btnZoomOut}"
                                Margin="0,0,8,0"
                                Click="BtnZoomOut_Click" />
                        <Button Content="+ Zoom"
                                Style="{StaticResource btnZoomIn}"
                                Click="BtnZoomIn_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="panelMultimedia"
                    Style="{StaticResource MediaPreviewContainerStyle}"
                    Visibility="Collapsed">
                <Grid Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <MediaElement x:Name="Video"
                                  Grid.Row="0"
                                  Style="{StaticResource MediaElementPreviewStyle}" />
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,0">
                        <Button Content="▶ Reproducir"
                                Style="{StaticResource btnPlay}"
                                Margin="0,0,8,0"
                                Click="BtnPlay_Click" />
                        <Button Content="Ⅱ Pausar"
                                Style="{StaticResource btnPause}"
                                Margin="0,0,8,0"
                                Click="BtnPause_Click" />
                        <Button Content="■ Detener"
                                Style="{StaticResource btnStop}"
                                Click="BtnStop_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="panelTexto"
                    Style="{StaticResource MediaPreviewContainerStyle}"
                    Visibility="Collapsed">
                <Grid Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="A−"
                                    Style="{StaticResource btnFontMinus}"
                                    Margin="0,0,8,0"
                                    ToolTip="Disminuir tamaño de fuente"
                                    Click="BtnFontMinus_Click" />
                            <Button Content="A+"
                                    Style="{StaticResource btnFontPlus}"
                                    Margin="0,0,8,0"
                                    ToolTip="Aumentar tamaño de fuente"
                                    Click="BtnFontPlus_Click" />
                            <Button Content="Guardar"
                                    Click="BtnGuardarTexto_Click" />
                        </StackPanel>
                        <TextBlock Text="Vista previa de texto"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox x:Name="textoBloque"
                             Grid.Row="1"
                             Style="{StaticResource TextPreviewStyle}" />
                </Grid>
            </Border>

            <Border x:Name="panelMarkdown"
                    Style="{StaticResource MarkdownPreviewContainerStyle}"
                    Visibility="Collapsed">
                <WebBrowser x:Name="webBrowser1"
                            Style="{StaticResource MarkdownWebBrowserStyle}" />
            </Border>

            <Border x:Name="panelVacio"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <TextBlock Text="Selecciona un archivo compatible para visualizarlo."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="24"
                           FontSize="16" />
            </Border>
        </Grid>

        <TextBlock x:Name="txtEstado"
                   Grid.Row="2"
                   Text="Listo"
                   Opacity="0.8" />
    </Grid>
</Window>
