<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="MediaPreviewContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="MediaElementPreviewStyle" TargetType="MediaElement">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="LoadedBehavior" Value="Manual" />
        <Setter Property="UnloadedBehavior" Value="Stop" />
    </Style>

    <Style x:Key="btnPlay" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="btnPause" TargetType="Button" BasedOn="{StaticResource btnPlay}" />
    <Style x:Key="btnStop" TargetType="Button" BasedOn="{StaticResource btnPlay}" />

    <Style x:Key="mediaSlider" TargetType="Slider">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
</ResourceDictionary>
